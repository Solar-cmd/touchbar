<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.touchbar</string>
  <key>ProgramArguments</key><array><string>__APP__/Contents/MacOS/touchbar</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>EnvironmentVariables</key><dict>
    <key>TB_WIDTH</key><string>1004</string>
    <key>TB_HEIGHT</key><string>30</string>
  </dict>
  <key>StandardErrorPath</key><string>/tmp/touchbar.log</string>
</dict></plist>
